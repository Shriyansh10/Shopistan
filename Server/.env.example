# Journal — Server/.env.example
#
# Before (user): server, database, Resend, JWT and payment (mock / Razorpay) settings.
#
# 2026-10-12 (Claude): Added CLIENT_URL (CORS origin; was read by app.ts but not listed), EMAIL_FROM and OTP_DEV_RECIPIENT
#   (OTP email sender / local-only recipient override).

# Server Configuration
port=8080
domain=http://localhost
mode=development

# Where the client runs — the only origin allowed to call the API with cookies (CORS)
CLIENT_URL=http://localhost:5173

# Database URI
MONGODB_URI=mongodb_db_uri

#Resend Key
RESEND_API_KEY=resend_api_key
# OTP sender, on a domain verified in Resend (e.g. no-reply@yourdomain.com); empty = Resend's test sender
EMAIL_FROM=
# local development only: send every OTP to this address (Resend's test sender can only mail your own account)
OTP_DEV_RECIPIENT=you@example.com

# JWT Secret
ACCESS_TOKEN_SECRET=secret_access_token_key
ACCESS_TOKEN_EXPIRATION=time

REFRESH_TOKEN_SECRET=secret_refresh_token_key
REFRESH_TOKEN_EXPIRATION=time

# Mock payment gateway — signs/verifies payments
PAYMENT_SECRET=payment_secret_key
# Payment gateway: "razorpay" or "mock"
PAYMENT_PROVIDER=mock
RAZORPAY_API_KEY=rzp_test_key_id
RAZORPAY_API_SECRET=razorpay_key_secret
# set when creating the webhook in the Razorpay dashboard (not the key secret)
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret
